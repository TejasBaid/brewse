{
  "name": "brewse",
  "version": "0.1.0",
  "description": "A browser that browses for you. Claude drives, Jev picks, code proves.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "brewse-mcp": "plugin/bin/brewse-mcp.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "headless": "electron . --headless",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "selftest": "electron-vite build && electron . --selftest --user-data=${TMPDIR:-/tmp}/brewse-selftest --url=https://example.com --urls=https://en.wikipedia.org/wiki/Espresso",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@anthropic-ai/sdk": "*",
    "@ghostery/adblocker-electron": "^2.20.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "solid-js": "^1.9.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
